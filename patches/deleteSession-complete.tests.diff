+/** Keyless real Web composition: delete a host-owned idle session with queued writes. */
+import { expect, it } from 'vitest'
+import { readFile } from 'node:fs/promises'
+import { SessionId } from '@deepseek-ai/dsh-session'
+import { RpcId } from '@deepseek-ai/dsh-host-apiproxy/api/rpc'
+import { launchWebScaffold, seedSession } from './scaffold.ts'
+
+it.each(['created', 'resumed', 'forked'])('permanently removes an archived %s session', async (kind) => {
+  const scaffold = await launchWebScaffold()
+  const { ctx } = scaffold
+  let sessionId = SessionId('archive-delete-regression')
+  let sequence = 0
+  const request = <P>(payload: P) => ({ rpcId: RpcId(`delete-${++sequence}`), payload })
+  try {
+    if (kind === 'resumed') {
+      await seedSession(scaffold, await readFile(new URL('./snapshots/seeded-history/seed.jsonl', import.meta.url), 'utf8'), sessionId)
+      expect(ctx.agents.get(sessionId)).toBeUndefined()
+      expect((await ctx.apiProxy.sessions.rename(request({ sessionId, title: 'Resume then delete' }))).result.ok).toBe(true)
+      expect(ctx.agents.get(sessionId)).toBeDefined()
+    } else {
+      const created = await ctx.apiProxy.sessions.create(request({ sessionId, cwd: scaffold.workspaceCwd }))
+      expect(created.result.ok).toBe(true)
+      const session = ctx.sessions.get(sessionId)!
+      session.append('turn/start', { turn: 1 })
+      session.append('turn/end', { turn: 1, reason: { kind: 'completed' } })
+      if (kind === 'forked') {
+        const result = (await ctx.apiProxy.sessions.fork(request({ sessionId }))).result
+        expect(result.ok).toBe(true)
+        if (!result.ok) throw new Error(result.error.message)
+        sessionId = result.value.sessionId
+      }
+    }
+    const header = ctx.sessions.get(sessionId)!.header
+    await ctx.sessionProjectionCache.write(ctx.sessions.get(sessionId)!)
+    expect((await ctx.apiProxy.workspace.archiveSession(request({ sessionId }))).result.ok).toBe(true)
+    expect((await ctx.apiProxy.workspace.deleteSession(request({ sessionId }))).result.ok).toBe(true)
+    const view = {
+      cached: ctx.sessionProjectionCache.cachedSnapshot(header) !== undefined,
+      liveSession: ctx.sessions.get(sessionId) !== undefined,
+      liveAgent: ctx.agents.get(sessionId) !== undefined,
+      archived: ctx.workspaceRegistry.archivedSessionIds.includes(sessionId),
+      persisted: (await ctx.sessionPersistence.list()).some(row => row.id === sessionId),
+      attached: ctx.workspaceRegistry.list().some(item => item.sessionIds.includes(sessionId)),
+    }
+    expect(view).toMatchInlineSnapshot(`
+      {
+        "archived": false,
+        "attached": false,
+        "cached": false,
+        "liveAgent": false,
+        "liveSession": false,
+        "persisted": false,
+      }
+    `)
+    await expect(ctx.sessionPersistence.inspect(sessionId)).rejects.toThrow('not found')
+  } finally { await scaffold.close() }
+})
