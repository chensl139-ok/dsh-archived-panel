{
  "name": "dsh-archived-panel",
  "version": "0.1.0",
  "description": "DSH plugin: a side panel that lists archived sessions, opens them, and unarchives them (unarchive requires the optional unarchiveSession patch).",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "patches/**/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json && tsdown",
    "prepare": "tsc -b tsconfig.json && tsdown",
    "clean": "rm -rf lib"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-client-runtime": "^0.1.0",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0",
    "@deepseek-ai/cordis": "^0.1.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-runtime": "^0.1.0",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0",
    "@deepseek-ai/cordis": "^0.1.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
