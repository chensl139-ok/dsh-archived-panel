{
  "name": "dsh-archived-panel",
  "version": "0.5.1",
  "description": "A native DeepSeek Harness sidebar panel for searching, restoring, and permanently deleting archived sessions.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "archived-sessions",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chensl139-ok/dsh-archived-panel.git"
  },
  "homepage": "https://github.com/chensl139-ok/dsh-archived-panel#readme",
  "bugs": {
    "url": "https://github.com/chensl139-ok/dsh-archived-panel/issues"
  },
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.mjs"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "lib/index.mjs",
    "lib/index.mjs.map",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json && tsdown && node scripts/wrap-client.mjs",
    "prepare": "pnpm run build",
    "clean": "rm -rf lib",
    "pack:check": "pnpm pack --dry-run",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "packageManager": "pnpm@11.22.0",
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.5",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@testing-library/react": "^16.3.3",
    "@types/react": "~18.3.1",
    "jsdom": "^30.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
